# Copy to .env (read from the working directory; variables already exported win) and fill in.
# For each role: MODEL is a litellm model id; API_BASE unset means the provider's own endpoint;
# API_KEY unset means litellm's provider variables (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...).
# A value still holding a <placeholder> is reported as unset.

# The patient: DeepSeek-V4.1-Flash on a vLLM server by default; any tool-calling model works
# (e.g. vertex_ai/claude-sonnet-4-6, with API_BASE empty).
MINDEVAL_PATIENT_MODEL=hosted_vllm/DeepSeek-V4.1-Flash
MINDEVAL_PATIENT_API_BASE=http://<patient-host>:<port>/v1
MINDEVAL_PATIENT_API_KEY=

# The counselor under test. For a hosted API (openai/..., anthropic/...), leave API_BASE empty.
MINDEVAL_COUNSELOR_MODEL=hosted_vllm/<served-name>
MINDEVAL_COUNSELOR_API_BASE=http://<counselor-host>:<port>/v1
MINDEVAL_COUNSELOR_API_KEY=

# The judge for `python mindeval/scripts/generate_judgments.py`: GPT-6.1 Sol by default, which needs OPENAI_API_KEY
# (on Azure, azure/<deployment> with litellm's AZURE_API_BASE, AZURE_API_KEY and AZURE_API_VERSION). Any other
# model works too. Its prompt ships in mindeval/judge_prompts.py; MINDEVAL_JUDGE_PROMPT replaces it with a file.
MINDEVAL_JUDGE_MODEL=openai/gpt-6.1-sol
MINDEVAL_JUDGE_API_BASE=
MINDEVAL_JUDGE_API_KEY=
# MINDEVAL_JUDGE_PROMPT=
